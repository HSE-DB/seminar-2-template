@startuml ERD_Example

!function $pk($a)
!return "<color:RoyalBlue>" + $a + " <<PK>></color>"
!endfunction

!function $unique($a)
!return "<color:Crimson>" + $a + " <<unique>></color>"
!endfunction

!function $setBold($a)
!return "<b>" + $a + " </b>"
!endfunction

skinparam BackgroundColor SeaShell
skinparam LegendBackgroundColor MistyRose
skinparam LegendBorderColor PaleVioletRed
skinparam LegendFontColor PaleVioletRed

skinparam Class {
    HeaderBackgroundColor PaleGreen
}
skinparam TitleFontColor Sienna

Header Пример E/R-диаграммы
Title E/R-диаграмма «Пример базы данных»

' ------------------------- Сущности -------------------------
entity "$setBold("Пользователь")" as User {
    * $pk("Идентификатор")
    * Логин
    * Пароль
    Имя
    Фамилия
    Дата_рождения
}

entity "$setBold("Заказ")" as Order {
    * $pk("Номер_заказа")
    * Описание
    Дата_создания
    Статус
}

entity "$setBold("Продукт")" as Product {
    * $pk("Код_продукта")
    * Название
    Цена
    Количество
}

entity "$setBold("Платёж")" as Payment {
    * $pk("Номер_платежа")
    Дата_платежа
    Сумма
}

entity "$setBold("Склад")" as Warehouse {
    * $pk("Код_склада")
    Адрес
    Вместимость
}

' ------------------------- Связи -------------------------
' Один к одному:
User ||--|| Payment : "Платёжный профиль"

' Один ко многим:
User ||--o{ Order : "Создаёт"
' Обратное направление (многие к одному):
Order }o--|| User : "Принадлежит"

' Многие ко многим:
Order }o--o{ Product : "Содержит"

' Дополнительный пример связи «один ко многим»:
Warehouse ||--o{ Product : "Размещает"

' ------------------------- Легенда -------------------------
legend right
$setBold("Условные обозначения:")
|| — ровно один.
o| или |o — ноль или один.
o{ или }o — ноль или более.
|{ или }| — один или более.
}o--o{ — связь «многие ко многим» с необязательным участием с обеих сторон.
end legend

@enduml
