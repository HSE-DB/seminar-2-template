@startuml

entity "Читатель" as Reader {
  *ID : PK
  --
  Имя
  Фамилия
  Адрес
  Дата рождения
}

entity "Бронирование" as Booking {
  --
  Дата выдачи
  План. дата возврата
  Факт. дата возврата
}

entity "Экземпляр" as Copy {
  *Номер.копии : PK
  --
  Положение на полке
}

entity "Издательство" as Publisher {
  *Название : PK
  --
  Адрес
}

entity "Категория" as Category {
  *Название : PK
}

entity "Книга" as Book {
  *ISBN : PK
  --
  Название
  Автор
  Год издания
  Количество страниц
}

' --- Связи ---

' Читатель (1) --- (0..*) Бронирование
Reader ||--o{ Booking

' Бронирование (0..*) --- (1) Экземпляр
Booking }o--|| Copy

' Издательство (1) --- (0..*) Книга
Publisher ||--o{ Book

' Категория (1) --- (0..*) Книга
Category ||--o{ Book

' Экземпляр (0..*) --- (1) Книга
Copy }o--|| Book

' Рекурсивная связь у Категории (подкатегории)
Category ||--o{ Category

@enduml
