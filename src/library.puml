@startuml ERD_Example

!function $pk($a)
!return "<color:RoyalBlue>" + $a + " <<PK>></color>"
!endfunction

!function $unique($a)
!return "<color:Crimson>" + $a + " <<unique>></color>"
!endfunction

!function $setBold($a)
!return "<b>" + $a + " </b>"
!endfunction

skinparam BackgroundColor SeaShell
skinparam LegendBackgroundColor MistyRose
skinparam LegendBorderColor PaleVioletRed
skinparam LegendFontColor PaleVioletRed

skinparam Class {
    HeaderBackgroundColor PaleGreen
}
skinparam TitleFontColor Sienna

Header Пример E/R-диаграммы
Title Задание 1.

' ------------------------- Сущности -------------------------
entity "$setBold("Читатель")" as Reader {
    * $pk("ID")
    Имя
    Фамилия
    Адрес
    Дата_рождения
}

entity "$setBold("Бронирование")" as Loan {
    Дата_выдачи
    Планируемая_дата_возврата
    Фактическая_дата_возврата
}

entity "$setBold("Экземпляр")" as Copy {
    * $pk("Номер_копии")
    Расположение_на_полке
}

entity "$setBold("Книга")" as Book {
    * $pk("ISBN")
    Название
    Автор
    Год_издания
    Количество_страниц
}

entity "$setBold("Издательство")" as Publisher {
    * $pk("Название")
    Адрес
}

entity "$setBold("Категория")" as Category {
    * $pk("Название")
}

' ------------------------- Связи -------------------------


Reader ||--o{ Loan : "Оформляет"
Loan }o--|| Copy : "Выдаёт"
Book ||--o{ Copy : "Содержит"
Publisher ||--o{ Book : "Издаёт"
Book }|--o{ Category : "Принадлежит"
Category "0..1" -- "0..*" Category : "Содержит"

' ------------------------- Легенда -------------------------
legend right
$setBold("Условные обозначения:")
|| — ровно один.
o| или |o — ноль или один.
o{ или }o — ноль или более.
|{ или }| — один или более.
}o--o{ — связь «многие ко многим» с необязательным участием с обеих сторон.
end legend

@enduml