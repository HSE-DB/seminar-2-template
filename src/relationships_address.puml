@startuml

entity "Страна" as Country {
}

entity "Город" as City {
}

entity "Улица" as Street {
}

entity "Дом" as House {
}

entity "Квартира" as Apartment {
}

' --- Связи ---

' В одной стране много городов
Country ||--o{ City

' В одном городе много улиц
City ||--o{ Street

' На одной улице много домов
Street ||--o{ House

' В одном доме много квартир
House ||--o{ Apartment

@enduml
